APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=running_event
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

# Daftar IP proxy/load balancer yang dipercaya, pisahkan dengan koma.
# KOSONGKAN di lingkungan tanpa proxy. JANGAN pakai '*'.
TRUSTED_PROXIES=

# Daftar host yang valid untuk aplikasi, pisahkan dengan koma.
# Contoh: localhost,example.com,app.example.com
TRUSTED_HOSTS=localhost,127.0.0.1

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Object Storage (FileGator CDN) untuk bukti pembayaran
# Gunakan 'object_storage' untuk mengaktifkan FileGator, atau 'local' untuk testing lokal
PAYMENT_PROOF_DISK=local
PAYMENT_PROOF_MAX_KB=2048
OBJECT_STORAGE_BASE_URL=https://dev.kantorku.my.id/cdn/api/v1
OBJECT_STORAGE_TOKEN=
OBJECT_STORAGE_FOLDER=running-event

